generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  manager
  crew
  accountant
  client
}

model User {
  id              Int       @id @default(autoincrement())
  name            String
  email           String    @unique
  password        String
  role            Role
  status          String    @default("Active")
  lastActive      String    @default("Never")
  avatar          String    @default("")
  twoFactorSecret String?
  twoFactorEnabled Boolean  @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  assignedProjects Project[] @relation("ProjectManager")
  sentMessages    Message[]
  tasks           Task[]
}

model Setting {
  id      Int    @id @default(autoincrement())
  key     String @unique
  value   String
  updatedAt DateTime @updatedAt
}

model Client {
  id            Int       @id @default(autoincrement())
  name          String
  company       String
  email         String    @unique
  phone         String
  projects      Int       @default(0)
  status        String    @default("Active")
  lastActivity  String    @default("Never")
  avatar        String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  projects_rel  Project[]
  invoices       Invoice[]
  payments        Payment[]
}

model Project {
  id            Int       @id @default(autoincrement())
  name          String
  clientName    String
  clientId        Int
  managerName   String
  managerId       Int
  status        String    @default("Planning")
  budget        Float     @default(0)
  spent         Float     @default(0)
  timeline      String    @default("")
  progress      Int       @default(0)
  color         String    @default("bg-blue-500")
  createdAt     DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  client        Client    @relation(fields: [clientId], references: [id])
  manager       User      @relation("ProjectManager", fields: [managerId], references: [id])
  scripts       Script[]
  storyboards   Storyboard[]
  shotLists     ShotList[]
  permits       Permit[]
  teamMembers   TeamMember[]
  tasks         Task[]
  scheduleEvents ScheduleEvent[]
  assets        Asset[]
  conversations  Conversation[]
}

model Equipment {
  id            Int       @id @default(autoincrement())
  name          String
  category      String
  status        String    @default("Available")
  assignedTo   String    @default("-")
  location      String    @default("")
  returnDate    String    @default("-")
  createdAt     DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Script {
  id            Int       @id @default(autoincrement())
  title         String
  projectId      Int
  status        String    @default("Draft")
  assignee     String    @default("")
  lastUpdated   String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project       Project   @relation(fields: [projectId], references: [id])
}

model Storyboard {
  id            Int       @id @default(autoincrement())
  title         String
  projectId      Int
  status        String    @default("Pending")
  assignee     String    @default("")
  lastUpdated   String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project        Project   @relation(fields: [projectId], references: [id])
}

model ShotList {
  id            Int       @id @default(autoincrement())
  title         String
  projectId    Int
  status        String    @default("Draft")
  assignee     String    @default("")
  lastUpdated   String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project        Project   @relation(fields: [projectId], references: [id])
}

model Permit {
  id            Int       @id @default(autoincrement())
  title         String
  projectId    Int
  status        String    @default("Pending")
  assignee     String    @default("")
  lastUpdated   String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project        Project   @relation(fields: [projectId], references: [id])
}

model TeamMember {
  id            Int       @id @default(autoincrement())
  name          String
  role          String
  projectId    Int
  status        String    @default("Available")
  tasks         Int       @default(0)
  availability  Int       @default(100)
  contact       String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project        Project   @relation(fields: [projectId], references: [id])
}

model Expense {
  id            Int       @id @default(autoincrement())
  description   String
  department    String
  amount        Float
  requestedBy    String
  date          String
  status        String    @default("Pending")
  createdAt      DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Invoice {
  id            String    @id
  clientName    String
  clientId      Int
  amount        Float
  date          String
  dueDate       String
  status        String    @default("Pending")
  items         String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  client         Client    @relation(fields: [clientId], references: [id])
  payments       Payment[]
}

model Payment {
  id            String    @id
  invoiceId     String
  clientName    String
  clientId      Int
  amount        Float
  date          String
  method        String    @default("")
  status        String    @default("Pending")
  createdAt     DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  client         Client    @relation(fields: [clientId], references: [id])
  invoice        Invoice   @relation(fields: [invoiceId], references: [id])
}

model Task {
  id            Int       @id @default(autoincrement())
  title         String
  projectId    Int
  priority      String    @default("Medium")
  status        String    @default("To Do")
  dueDate       String    @default("")
  assignee      String    @default("")
  userId        Int?
  createdAt     DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project        Project   @relation(fields: [projectId], references: [id])
  assignee_user User?      @relation(fields: [userId], references: [id])
}

model ScheduleEvent {
  id            Int       @id @default(autoincrement())
  date          Int
  title         String
  projectId    Int
  location      String    @default("")
  crew          String    @default("0")
  time          String    @default("")
  status        String    @default("Tentative")
  createdAt      DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project        Project   @relation(fields: [projectId], references: [id])
}

model Asset {
  id            Int       @id @default(autoincrement())
  name          String
  type          String
  folder        String    @default("footage")
  projectId    Int
  uploadedBy      String    @default("")
  date          String    @default("")
  size          String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project        Project   @relation(fields: [projectId], references: [id])
}

model Conversation {
  id            Int       @id @default(autoincrement())
  name          String
  role          String    @default("")
  projectId    Int?
  avatar        String    @default("")
  lastMessage   String    @default("")
  time          String    @default("")
  unread        Int       @default(0)
  online        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project        Project?   @relation(fields: [projectId], references: [id])
  messages       Message[]
}

model Message {
  id              Int       @id @default(autoincrement())
  conversationId  Int
  sender          String
  text            String
  time            String    @default("")
  isMe            Boolean   @default(false)
  createdAt       DateTime  @default(now())

  conversation     Conversation @relation(fields: [conversationId], references: [id])
  user             User?         @relation(fields: [senderId], references: [id])
  senderId         Int?
}